# Copy to .env and fill in. .env is ignored by git; never commit a real key.

# OpenAI-compatible endpoint (OpenAI itself, or a local proxy such as VibeProxy)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=12000
MAX_REQUESTS_PER_HOUR=20
PORT=8765

# Required when the server is reachable from outside this computer (e.g. behind nginx).
# Without it, AI requests are accepted only from 127.0.0.1 / localhost.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WORKSHOP_ACCESS_KEY=
# Or open the AI to everyone who can reach the site (MAX_REQUESTS_PER_HOUR still applies):
# WORKSHOP_PUBLIC_API=1

# Local VibeProxy example:
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# OPENAI_API_KEY=your_vibeproxy_key
# OPENAI_MODEL=gemini-3.8-flash
